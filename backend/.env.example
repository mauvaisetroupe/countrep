# Configuration de développement : copier en backend/.env (ignoré par git).
# Toutes les variables sont décrites dans docs/exploitation.md.

# La base de compose.dev.yml
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=countrep
DATABASE_USER=countrep
DATABASE_PASSWORD=countrep

# Obligatoire, sans valeur par défaut : openssl rand -base64 48
JWT_SECRET=

# Le client OAuth Web du projet Google Cloud countrep (public, ADR 0013)
GOOGLE_CLIENT_IDS=14127079549-o2h7n8qpjnru8v257fpqkjo8mppluqfo.apps.googleusercontent.com

# Serveurs Vite admis par CORS : localhost et l'adresse de la machine sur
# le réseau local (téléphone)
CORS_ORIGINS=http://localhost:5173,http://192.168.1.109:5173
